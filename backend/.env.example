MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=
PORT=5000
ALLOWED_ORIGIN=

# ==========================================================
# Outgoing email (used by "Send Report Email")
# Works with Gmail, Outlook/Office365, Zoho, or the SMTP relay
# of any transactional provider (SendGrid, Mailgun, Resend, SES).
# ==========================================================
# Gmail example: smtp.gmail.com
SMTP_HOST=
# 587 = STARTTLS (recommended), 465 = implicit TLS
SMTP_PORT=587
SMTP_SECURE=false
# Full mailbox address, e.g. audits@yourorg.org
SMTP_USER=
# Gmail: a 16-character App Password, NOT your normal login password
# (Google Account -> Security -> 2-Step Verification -> App passwords)
SMTP_PASS=
MAIL_FROM_NAME=Pratibimba Audit System
# Defaults to SMTP_USER if left blank
MAIL_FROM_EMAIL=
